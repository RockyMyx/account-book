# ================================================
# 服务端环境变量示例
# 复制为 .env 后填写真实值；.env 已被 .gitignore 忽略，不会提交
# ================================================

# 服务端口（本机 3000 已有其他 Node 服务占用，记账本开发默认用 3001）
PORT=3001

# 运行环境
NODE_ENV=development

# 家庭码（6 位数字，可选）：填了就固定用这个码，初始化和重置都不再随机生成
# 个人使用建议固定一个；留空则首次初始化时随机生成
FAMILY_CODE=

# ============ MySQL 连接 ============
# 程序会按 DB_* 自动生成 DATABASE_URL；不需要手填 DATABASE_URL。
# 首次使用请先创建数据库和用户，例如：
#   CREATE DATABASE accountbook CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
#   CREATE USER 'accountbook'@'%' IDENTIFIED BY '你的密码';
#   GRANT ALL PRIVILEGES ON accountbook.* TO 'accountbook'@'%';
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=accountbook
DB_PASSWORD=
DB_NAME=accountbook

# 智谱开放平台 API Key（coding plan 的 key 直接用）
# 用途：语音记账的文字解析（GLM）。ASR 语音识别用下方微软服务，不走智谱
ZHIPU_API_KEY=

# 接口端点（默认 coding plan 专用端点；换标准端点改为 https://open.bigmodel.cn/api/paas/v4）
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/coding/paas/v4

# GLM 模型名（文本解析用；免费快：glm-4-flash，更强：glm-5.3-flash 等）
ZHIPU_LLM_MODEL=glm-4-flash

# ============ 微软语音（Azure Speech，用于录音转文字） ============
# 免费层每月 5 小时音频，家庭记账绰绰有余
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=japaneast

# 设备令牌有效期（天）
DEVICE_TOKEN_TTL_DAYS=180

# JWT 密钥（首次启动时随机生成一串填入，用于签发设备令牌）
JWT_SECRET=

# 前端来源（CORS 允许的源，生产环境改为你的域名）
CORS_ORIGIN=http://localhost:5173
